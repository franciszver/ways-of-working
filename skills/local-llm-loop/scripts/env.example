# Environment variables run_loop.sh reads. Copy to .env and source it,
# or export these directly, before invoking run_loop.sh.

# Required. Base URL of your OpenAI-compatible endpoint (llama-server,
# any other server exposing /v1/chat/completions with tool calling).
# No default — a wrong silent default would point the loop at the
# wrong model without warning.
OPENAI_HOST=http://127.0.0.1:8080

# Required if your endpoint checks it; llama-server ignores an
# unexpected key, so a placeholder is fine for a local server with no
# auth.
OPENAI_API_KEY=sk-local

# Required. The model name your endpoint expects in requests. No
# generic default makes sense across servers, so run_loop.sh errors
# out if this is unset.
GOOSE_MODEL=your-model-name

# Optional. Points Goose's config resolution at a directory containing
# goose/config.yaml (see goose-config.example.yaml). If unset,
# run_loop.sh uses the bundled goose-config.example.yaml directly.
# XDG_CONFIG_HOME=~/.config/local-llm-loop

# Optional. Per-stage timeout in seconds for each `goose run` call.
# Default: 1800.
# LOOP_STAGE_TIMEOUT=1800

# Optional. The CLI harness command run_loop.sh runs each stage through,
# with `{prompt}` substituted for that stage's prompt file. Goose is the
# shipped default; set this to point the loop at a different CLI harness
# that accepts a prompt file the same way. See references/setup.md.
# LOOP_HARNESS_CMD="goose run --no-session -i {prompt}"
