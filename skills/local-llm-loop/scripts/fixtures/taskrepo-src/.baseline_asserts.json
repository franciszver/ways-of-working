      "lines": [
        "def test_roundtrip_basic_values(self):",
        "    store = Store()",
        "    store.set(\"a\", 1)",
        "    store.set(\"b\", \"text\")",
        "    data = dumps(store)",
        "    restored = loads(data)",
        "    self.assertEqual(restored.get(\"a\"), 1)",
