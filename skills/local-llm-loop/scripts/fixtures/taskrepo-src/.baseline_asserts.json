    "test_roundtrip_set_and_tuple": {
      "lines": [
        "def test_roundtrip_set_and_tuple(self):",
        "    store = Store()",
        "    store.set(\"s\", {1, 2, 3})",
        "    store.set(\"t\", (1, \"two\", 3.0))",
        "    data = dumps(store)",
        "    restored = loads(data)",
